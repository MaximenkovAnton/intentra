# Local host ports for the memory services (compose maps them onto the container ports).
FALKORDB_PORT=16379
QDRANT_PORT=16333
QDRANT_GRPC_PORT=16334
OLLAMA_PORT=11434

# Ollama model pulled by the one-shot ollama-init service.
OLLAMA_MODEL=bge-m3

# Values the API uses to reach the same services (never commit real secrets).
FALKORDB_URL=redis://127.0.0.1:16379
QDRANT_URL=http://127.0.0.1:16333
OLLAMA_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_INTERNAL_TOKEN=replace-with-a-long-random-token
