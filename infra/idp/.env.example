# Pocket ID environment for the IdP host.
# Copy to .env in this directory (gitignored) and fill it in; never commit .env or the certs.

# --- Public address of Pocket ID. Passkeys are bound to this domain, and the
# --- certificate in ./certs must cover the host. HTTPS is required for passkeys.
APP_URL=https://idp.example.com
IDP_PORT=1411

# --- Encryption key for the signing keys stored in SQLite (>= 16 bytes). ---
ENCRYPTION_KEY=CHANGE_ME

# --- Behind a reverse proxy set the proxies' address range. ---
TRUST_PROXY=false

# --- The control plane links an existing account only when the OIDC e-mail is
# --- verified; a single-admin IdP treats its configured addresses as such. ---
EMAILS_VERIFIED=true

# --- Fixed admin API key for declarative OIDC client provisioning (>= 16 chars). ---
STATIC_API_KEY=CHANGE_ME

# --- TLS certificate and key paths inside the container (mounted ./certs). ---
TLS_CERT_FILE=/certs/tls.crt
TLS_KEY_FILE=/certs/tls.key

# --- Bootstrap values for local provisioning tooling, not read by Pocket ID. ---
OIDC_CLIENT_NAME=intentra
OIDC_REDIRECT_URIS=http://localhost:8090/api/auth/callback
ADMIN_GROUP=intentra-admins
