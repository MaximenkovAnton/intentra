# syntax=docker/dockerfile:1

# ---------- build ----------
# Installs the pnpm workspace and produces the Vite production bundle.
FROM node:24-alpine AS build

RUN npm install --global pnpm@11.28.5
WORKDIR /repo

# Manifests first so the dependency layer is cached independently of the sources.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web

RUN pnpm --filter @intentra/contracts build \
 && pnpm --filter @intentra/web build

# ---------- runtime ----------
# nginx serves the static SPA and proxies /api and /api/events to the api service.
# The container runs as the non-root `nginx` user (uid 101) on port 8080.
FROM nginx:1.29-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY --chmod=644 infra/compose/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /repo/apps/web/dist /usr/share/nginx/html
# The build context may carry restrictive modes; the non-root nginx user must be
# able to read the bundle and traverse its directories.
RUN chmod -R a+rX /usr/share/nginx/html

ARG GIT_REVISION=unknown
LABEL org.opencontainers.image.revision=$GIT_REVISION

USER nginx
EXPOSE 8080
