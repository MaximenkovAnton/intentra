# Intentra control-plane environment.
# Copy to .env in this directory (gitignored), then fill in real values.
# Never commit .env or real secrets, and keep environment-specific addresses
# (internal IPs, hostnames, container IDs) out of this file.

# --- Public origin (web + api share one origin) ---
PUBLIC_URL=http://localhost:8090
WEB_PORT=8090
# Plain-HTTP development only; production requires TLS on PUBLIC_URL.
NODE_ENV=development

# --- Database (PostgreSQL 18) ---
DATABASE_URL=postgres://intentra:CHANGE_ME@postgres.example.com:5432/intentra

# --- Session secret (random, >= 32 bytes; generate with `openssl rand -hex 32`) ---
SESSION_SECRET=CHANGE_ME

# --- Authentication: oidc in production; dev only outside production ---
AUTH_MODE=oidc

# --- OIDC provider (Pocket ID or any compliant provider) ---
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=intentra
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=http://localhost:8090/api/auth/callback
OIDC_ADMIN_GROUP=intentra-admins

# --- Optional: local image tag used by the images built from this compose file ---
INTENTRA_IMAGE_TAG=local

# --- Memory (FalkorDB, Qdrant, Ollama) ---
FALKORDB_URL=redis://memory.example.com:16379
QDRANT_URL=http://memory.example.com:16333
OLLAMA_URL=http://memory.example.com:11434
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_INTERNAL_TOKEN=CHANGE_ME

# --- CA certificate of a private/self-signed IdP, used by docker-compose.idp-ca.yml ---
IDP_CA_CERT=./idp-ca.crt
# Only when the compose resolver cannot resolve the IdP name: pin it to its address
# (192.0.2.10 is the documentation TEST-NET-1 placeholder).
IDP_HOST=idp.example.com
IDP_HOST_IP=192.0.2.10

# --- Release channel (runner updates) ---
# Bearer token for POST /api/admin/releases and /yank; empty disables publishing (503).
# Generate with `openssl rand -hex 32`.
RELEASE_PUBLISH_TOKEN=CHANGE_ME
# Content-addressed artifact cache; mount a persistent volume here.
RELEASE_CACHE_DIR=/data/releases
# Maximum accepted artifact size in bytes (default 256 MiB).
RELEASE_MAX_ARTIFACT_BYTES=268435456
# Optional GitHub token; sent only to github.com when the centre downloads from Releases.
GITHUB_RELEASE_TOKEN=

# --- Logging ---
LOG_LEVEL=info
